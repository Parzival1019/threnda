# ---------------------------------------------------------------------------
# Threnda — example configuration
#
# Copy to `.env` and change every value before running anything real:
#
#     cp .env.example .env
#
# These are PLACEHOLDERS. Production deployments must not use the example
# values in this file — in particular THRENDA_SECRET_KEY. Treat any
# deployment still using `change-me` as compromised.
#
# `.env` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# Environment: development | production
THRENDA_ENV=development

# Secret key used to sign sessions and tokens.
# Generate a unique value per deployment, e.g.:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
THRENDA_SECRET_KEY=change-me

# Database. SQLite by default; the schema is PostgreSQL-compatible.
#     sqlite:///./data/threnda.db
#     postgresql+psycopg://threnda:CHANGE_ME@localhost:5432/threnda
THRENDA_DATABASE_URL=sqlite:///./data/threnda.db

# ---------------------------------------------------------------------------
# Optional local AI
#
# AI is entirely optional. Threnda runs fully offline with it disabled, and
# no external LLM provider is required. Leave disabled unless you want it.
# ---------------------------------------------------------------------------
THRENDA_AI_PROVIDER=disabled
THRENDA_AI_MODEL=
