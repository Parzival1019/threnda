# ---------------------------------------------------------------------------
# Threnda — example configuration
#
# Copy to `.env` and change every value before running anything real:
#
#     cp .env.example .env
#
# These are PLACEHOLDERS. Production deployments must not use the example
# values in this file — in particular THRENDA_SECRET_KEY. Treat any
# deployment still using `change-me` as compromised.
#
# `.env` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# Environment: development | production
THRENDA_ENV=development

# Secret key used to sign sessions and tokens.
# Generate a unique value per deployment, e.g.:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
THRENDA_SECRET_KEY=change-me

# Database. SQLite by default; the schema is PostgreSQL-compatible.
#     sqlite:///./data/threnda.db
#     postgresql+psycopg://threnda:CHANGE_ME@localhost:5432/threnda
# Docker Compose always uses PostgreSQL — see POSTGRES_PASSWORD below.
THRENDA_DATABASE_URL=sqlite:///./data/threnda.db

# Used only by docker-compose.yml, to build THRENDA_DATABASE_URL for the
# `db` service and to configure that Postgres container itself. Not read
# directly by the application. Required — `docker compose up` refuses to
# start without it.
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# First-admin bootstrap (docs/deployment.md)
#
# Set both the FIRST time you start a brand-new instance (via Docker
# Compose, or `threnda bootstrap-admin` locally) to create the first local
# admin account. Bootstrap is one-time and refuses to run again once any
# account exists — safe to leave these set, but there's no reason to keep
# a password in this file once the account is created. Never invents
# credentials: if left blank and running non-interactively (e.g. in a
# container), bootstrap simply does not create an account.
# ---------------------------------------------------------------------------
THRENDA_BOOTSTRAP_ADMIN_USERNAME=
THRENDA_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Cookie/session security
#
# Session and CSRF cookies are always HttpOnly + SameSite=Strict, and get
# the Secure flag whenever THRENDA_ENV=production or the request is HTTPS.
# Leave this unset/false everywhere except a local test of a production
# config over plain HTTP — startup refuses to run with THRENDA_ENV=
# production and this set to true (see threnda/app/core/startup_checks.py).
# ---------------------------------------------------------------------------
THRENDA_ALLOW_INSECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Outbound webhooks (docs/webhooks.md)
#
# THRENDA_WEBHOOK_ALLOW_PRIVATE_TARGETS disables the SSRF protection that
# otherwise blocks delivering to loopback/private/link-local addresses —
# for local development/tests pointing at a receiver on localhost only.
# Never set this in production.
# ---------------------------------------------------------------------------
THRENDA_WEBHOOK_ALLOW_PRIVATE_TARGETS=false
THRENDA_WEBHOOK_TIMEOUT_SECONDS=5
THRENDA_WEBHOOK_MAX_RESPONSE_BYTES=65536

# ---------------------------------------------------------------------------
# Optional local AI
#
# AI actions are opt-in in the UI, but the default provider is Threnda's
# managed, embedded llama.cpp runtime. No separate Ollama installation is
# required. Install the pinned runtime/model from Settings > Local AI or
# with `threnda ai install`. See docs/local-ai.md.
# ---------------------------------------------------------------------------
THRENDA_AI_PROVIDER=embedded
THRENDA_AI_MODEL=
THRENDA_AI_DATA_DIR=./data/ai
THRENDA_AI_BUNDLE_DIR=
THRENDA_AI_EMBEDDED_PORT=11435
THRENDA_AI_STARTUP_TIMEOUT_SECONDS=120

# Legacy/developer Ollama connection settings. Only used when
# THRENDA_AI_PROVIDER=ollama. Ordinary Community users do not need these.
# THRENDA_AI_BASE_URL must resolve to 127.0.0.1/localhost/::1 — Threnda
# refuses to start with anything else, since there is no cloud AI path.
THRENDA_AI_BASE_URL=http://127.0.0.1:11434
THRENDA_AI_TIMEOUT_SECONDS=30
THRENDA_AI_MAX_INPUT_CHARACTERS=50000
